EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK key (iOS "App-specific Public Apple API Key",
# starts with "appl_") from the LeashOff project in the RevenueCat dashboard.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# leash-remover-api (separate repo). Auth is the caller's own Supabase
# access token (/v2) — no shared secret needed.
EXPO_PUBLIC_LEASH_API_URL=
